# ===== LLM 供应商配置（OpenAI 兼容协议）=====
# 默认接入 Agnes AI 聚合服务：https://agnes-ai.com/
# 申请 API Key：登录 agnes-ai.com 后在控制台获取
LLM_API_KEY=your_agnes_api_key_here
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.0-flash
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2000

# ===== 嵌入模型 =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== 短期记忆轮数 =====
SHORT_MEMORY_MAX_TURNS=10
